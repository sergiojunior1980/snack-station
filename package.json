{
  "name": "snack-station",
  "private": true,
  "version": "0.1.0",
  "description": "Snack Station — estoque e vendas da estação de lanches",
  "scripts": {
    "dev": "next dev --port 43181 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 43181 --hostname 0.0.0.0",
    "lint": "eslint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:restart": "supabase stop && supabase start",
    "db:health": "supabase status",
    "db:env": "supabase status -o env",
    "db:status": "supabase status -o env",
    "db:setup": "pnpm install && pnpm db:start && pnpm db:types",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db:migration:up": "supabase migration up",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:seed": "supabase db dump --data-only --schema public -f supabase/seed.sql",
    "db:seed:remote": "supabase db dump --data-only --schema public --linked -f supabase/seed.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
